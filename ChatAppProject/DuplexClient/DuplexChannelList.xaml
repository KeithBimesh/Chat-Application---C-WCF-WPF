<Window x:Class="DuplexClient.DuplexChannelList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DuplexClient"
        mc:Ignorable="d"
        Title="DuplexChannelList" Height="450" Width="800">
    <Grid>
        <Label Content="Available Channels" FontSize="25" FontWeight="Bold" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label x:Name="User" Content="User" FontSize="14" Margin="20,65,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="ChannelList" Margin="20,105,265,80"/>
        <Button x:Name="JoinButton" Content="Join Channel" Width="120" Height="35" Margin="20,0,0,25" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="JoinButton_Click"/>
        <Label Content="Channel Name" Margin="544,105,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="Channel_Name" Width="180" Height="30" Margin="546,132,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="CreateButton" Content="Create Channel" Width="120" Height="35" Margin="548,176,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Click="CreateButton_Click"/>
        <Button x:Name="SignOutButton" Content="Sign Out" Width="120" Height="35" Margin="0,0,20,25" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SignOutButton_Click"/>

    </Grid>
</Window>
