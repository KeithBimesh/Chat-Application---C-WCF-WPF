<Window x:Class="DuplexClient.DuplexPrivateConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DuplexClient"
        mc:Ignorable="d"
        Title="DuplexPrivateConversationWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="Private_Conversation" Content="Private Conversation" FontSize="24" FontWeight="Bold" Margin="40,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="PrivateMessageList" Margin="20,50,70,100" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <TextBox x:Name="PrivateMessageText" Margin="235,0,362,34" Height="35" VerticalAlignment="Bottom"/>
        <Button x:Name="PrivateMsgSendButton" Content="Send" Width="88" Height="35" Margin="0,0,245,34" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="PrivateMsgSendButton_Click"/>


    </Grid>
</Window>
