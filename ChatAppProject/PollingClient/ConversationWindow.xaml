<Window x:Class="PollingClient.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PollingClient"
        mc:Ignorable="d"
        Title="ConversationWindow" Height="450" Width="800">
    <Grid>
        <Label x:Name="Channel_Name" Content="Channel" FontSize="30" FontWeight="Bold" Margin="76,15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label x:Name="User_Name" Content="User" Margin="82,60,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="Messages_list" Margin="90,90,380,101"/>
        <Label Content="Members" FontSize="18" FontWeight="Bold" Margin="464,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="MembersList" Margin="469,91,176,173"/>
        <TextBox x:Name="MessageInput" Margin="90,338,402,0" Height="35" VerticalAlignment="Top"/>
        <Button x:Name="SendButton" Content="Send" Width="80" Height="30" Margin="0,0,296,62" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SendButton_Click"/>
        <Button x:Name="LeaveButton" Content="Leave" Width="80" Height="30" Margin="138,0,0,20" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="LeaveButton_Click"/>
        <Button x:Name="PrivateCoversationButton" Content="Private Conversation" Width="112" Height="30" Margin="0,0,62,173" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="PrivateConversationButton_Click"/>
        <Label Content="Shared Files" FontSize="18" FontWeight="Bold" Margin="554,270,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <ListBox x:Name="SharedFileList" Margin="562,305,28,50"/>
        <Button x:Name="SharedFileButton" Content="Share file" Width="80" Height="30" Margin="0,0,21,13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SharedFileButton_Click"/>
        <Button x:Name="DownloadButton" Content="Download" Width="80" Height="30" Margin="0,0,158,13" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="DownloadButton_Click"/>
        <Button x:Name="SignOutButton" Content="Sign Out" Width="80" Height="30" Margin="0,0,701,19" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SignOutButton_Click"/>
    </Grid>
</Window>
