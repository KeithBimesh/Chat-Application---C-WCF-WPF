<Window x:Class="PollingClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PollingClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Chat Application" FontSize="30" FontWeight="Bold" Margin="269,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Content="User ID" Margin="269,100,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox x:Name="User_ID" Margin="325,100,0,0" Width="190" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="SignInButton" Content="Sign In" Margin="325,145,0,0" Width="85" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Click="SignInButton_Click"/>

    </Grid>
</Window>
